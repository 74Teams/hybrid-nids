# Mật khẩu root của MySQL (bắt buộc), nên dùng chuỗi hex: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
# Mật khẩu tài khoản ứng dụng NIDS trong MySQL (bắt buộc), nên dùng chuỗi hex
NIDS_DB_PASSWORD=
# Mật khẩu Redis đẩy cảnh báo realtime (bắt buộc), nên dùng chuỗi hex: openssl rand -hex 24
NIDS_REDIS_PASSWORD=
# API key của NIDS (tuỳ chọn), nên dùng chuỗi hex: openssl rand -hex 32
NIDS_API_KEY=
