alert udp $EXTERNAL_NET any -> $HOME_NET 69 (msg:"PROTOCOL-TFTP parent directory"; flow:to_server; content:"..",offset 2; reference:cve,1999-0183; reference:cve,2002-1209; reference:cve,2007-0888; reference:cve,2011-4722; classtype:bad-unknown; priority:2; sid:519; rev:16;)
alert udp $EXTERNAL_NET any -> $HOME_NET 69 (msg:"PROTOCOL-TFTP root directory"; flow:to_server; content:"|00 01|/",depth 3; reference:cve,1999-0183; classtype:bad-unknown; priority:2; sid:520; rev:13;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 139 (msg:"NETBIOS SMB CD.."; flow:to_server,established; content:"|5C|../|00 00 00|"; classtype:attempted-recon; priority:2; sid:534; rev:9;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 139 (msg:"NETBIOS SMB CD..."; flow:to_server,established; content:"|5C|...|00 00 00|"; classtype:attempted-recon; priority:2; sid:535; rev:9;)
alert tcp $HOME_NET any <> $EXTERNAL_NET 1863 (msg:"POLICY-SOCIAL Microsoft MSN message"; flow:established; content:"MSG ",depth 4; content:"Content-Type|3A|",nocase; content:"text/plain",distance 1; classtype:policy-violation; priority:1; sid:540; rev:17;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"POLICY-SOCIAL ICQ access"; flow:to_server,established; content:"User-Agent|3A|ICQ",fast_pattern; classtype:policy-violation; priority:1; sid:541; rev:15;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 21 (msg:"POLICY-OTHER FTP anonymous login attempt"; flow:to_server,established; content:"USER",fast_pattern; pcre:"/^USER\s+(anonymous|ftp)[^\w]*[\r\n]/smi"; classtype:misc-activity; priority:3; sid:553; rev:13;)
alert tcp $HOME_NET 23 -> $EXTERNAL_NET any (msg:"POLICY-OTHER WinGate telnet server response"; flow:to_client,established; content:"WinGate>"; reference:cve,1999-0657; classtype:misc-activity; priority:3; sid:555; rev:13;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"APP-DETECT VNC server response"; flow:established; content:"RFB 0",depth 5; content:".0",offset 7,depth 2; classtype:misc-activity; priority:3; sid:560; rev:10;)
alert udp $EXTERNAL_NET any -> $HOME_NET 5632 (msg:"APP-DETECT PCAnywhere server response"; content:"ST",depth 2; classtype:misc-activity; priority:3; sid:566; rev:11;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 9100 (msg:"POLICY-OTHER HP JetDirect LCD modification attempt"; flow:to_server,established; content:"@PJL RDYMSG DISPLAY ="; reference:bugtraq,2245; classtype:misc-activity; priority:3; sid:568; rev:11;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 32771:34000 (msg:"PROTOCOL-RPC DOS ttdbserv Solaris"; flow:to_server,established; content:"|00 00 00 00|",offset 8,depth 4; content:"|00 01 86 F3 00 00 00 01 00 00 00 0F 00 00 00 01|",offset 16,depth 32; reference:bugtraq,122; reference:cve,1999-0003; classtype:attempted-dos; priority:2; sid:572; rev:14;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"PROTOCOL-RPC mountd TCP export request"; flow:to_server,established; content:"|00 01 86 A5|",offset 16,depth 4; content:"|00 00 00 05|",distance 4,within 4; content:"|00 00 00 00|",offset 8,depth 4; classtype:attempted-recon; priority:2; sid:574; rev:14;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 111 (msg:"PROTOCOL-RPC portmap listing TCP 111"; flow:to_server,established; content:"|00 01 86 A0|",offset 16,depth 4; content:"|00 00 00 04|",distance 4,within 4; content:"|00 00 00 00|",offset 8,depth 4; classtype:rpc-portmap-decode; priority:2; sid:598; rev:23;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 32771 (msg:"PROTOCOL-RPC portmap listing TCP 32771"; flow:to_server,established; content:"|00 01 86 A0|",offset 16,depth 4; content:"|00 00 00 04|",distance 4,within 4; content:"|00 00 00 00|",offset 8,depth 4; classtype:rpc-portmap-decode; priority:2; sid:599; rev:17;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 513 (msg:"PROTOCOL-SERVICES rlogin LinuxNIS"; flow:to_server,established; content:"|3A 3A 3A 3A 3A 3A 3A 3A 00 3A 3A 3A 3A 3A 3A 3A 3A|",fast_pattern; classtype:bad-unknown; priority:2; sid:601; rev:11;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 513 (msg:"PROTOCOL-SERVICES rlogin bin"; flow:to_server,established; content:"bin|00|bin|00|",fast_pattern; classtype:attempted-user; priority:1; sid:602; rev:11;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 513 (msg:"PROTOCOL-SERVICES rlogin echo++"; flow:to_server,established; content:"echo |22| + + |22|",fast_pattern; classtype:bad-unknown; priority:2; sid:603; rev:11;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 513 (msg:"PROTOCOL-SERVICES Unix rlogin froot parameter root access attempt"; flow:to_server,established; content:"-froot|00|",fast_pattern; reference:bugtraq,458; reference:cve,1999-0113; classtype:attempted-admin; priority:1; sid:604; rev:15;)
alert tcp $HOME_NET 513 -> $EXTERNAL_NET any (msg:"PROTOCOL-SERVICES rlogin login failure"; flow:to_client,established; content:"login incorrect",fast_pattern; classtype:unsuccessful-user; priority:1; sid:605; rev:13;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 514 (msg:"PROTOCOL-SERVICES rsh bin"; flow:to_server,established; content:"bin|00|bin|00|",fast_pattern; classtype:attempted-user; priority:1; sid:607; rev:10;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 514 (msg:"PROTOCOL-SERVICES rsh echo + +"; flow:to_server,established; content:"echo |22|+ +|22|",fast_pattern; classtype:attempted-user; priority:1; sid:608; rev:10;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 514 (msg:"PROTOCOL-SERVICES rsh froot"; flow:to_server,established; content:"-froot|00|",fast_pattern; classtype:attempted-admin; priority:1; sid:609; rev:10;)
