# =============================================================================
# HYBRID NIDS - TẬP LUẬT TỰ ĐỊNH NGHĨA (cú pháp Snort 3)
# Quy tắc viết rule: .claude/rules/snort-rules.md
#
# Dải SID:
#   10000xx  WEB-ATTACK   tấn công ứng dụng web
#   10001xx  SCAN         quét cổng / quét mạng
#   10002xx  DOS          từ chối dịch vụ
#   10003xx  AUTH         dò mật khẩu / đăng nhập
#   10004xx  MALWARE, C2  mã độc, công cụ tấn công tự động
#   10005xx  RECON        thăm dò qua UDP / ICMP
# =============================================================================


# -----------------------------------------------------------------------------
# 10000xx - WEB-ATTACK
# -----------------------------------------------------------------------------

# SQL Injection
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK SQL Injection - UNION SELECT detected"; flow:to_server,established; http_uri; content:"union",nocase; content:"select",nocase,distance 0; service:http; classtype:web-application-attack; priority:1; sid:1000001; rev:2;)
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK SQL Injection - Classic OR boolean bypass"; flow:to_server,established; http_uri; content:"or",nocase; pcre:"/\bor[\s+]+[\x27\x22]?\d+[\x27\x22]?[\s+]*(=|%3d)[\s+]*[\x27\x22]?\d+/i"; service:http; classtype:web-application-attack; priority:1; sid:1000002; rev:2;)
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK SQL Injection - SQL comment execution (--)"; flow:to_server,established; http_uri; content:"--"; service:http; classtype:web-application-attack; priority:2; sid:1000003; rev:2;)

# Cross-Site Scripting (XSS)
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK Cross-Site Scripting - SCRIPT tag attempt"; flow:to_server,established; http_uri; content:"<script",nocase; service:http; classtype:web-application-attack; priority:1; sid:1000010; rev:2;)
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK Cross-Site Scripting - Javascript URI handler"; flow:to_server,established; http_uri; content:"javascript:",nocase; service:http; classtype:web-application-attack; priority:2; sid:1000011; rev:2;)
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK Cross-Site Scripting - Event handler payload"; flow:to_server,established; http_client_body; pcre:"/on(error|load|mouseover)\s*=/i"; service:http; classtype:web-application-attack; priority:1; sid:1000012; rev:2;)

# Path Traversal / LFI
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK Path Traversal - Directory traversal attempt (../)"; flow:to_server,established; http_uri; content:"../"; service:http; classtype:web-application-attack; priority:1; sid:1000020; rev:2;)
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK Sensitive File Access - /etc/passwd access attempt"; flow:to_server,established; http_uri; content:"/etc/passwd"; service:http; classtype:attempted-admin; priority:1; sid:1000021; rev:2;)
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK Sensitive File Access - Windows win.ini access"; flow:to_server,established; http_uri; content:"win.ini",nocase; service:http; classtype:attempted-admin; priority:1; sid:1000022; rev:2;)

# Command Injection (RCE)
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK Command Injection - Chained commands execution"; flow:to_server,established; http_uri; pcre:"/(\|[\s+]*id\b|\x3b[\s+]*cat[\s+]|&[\s+]*whoami)/i"; service:http; classtype:web-application-attack; priority:1; sid:1000030; rev:2;)


# -----------------------------------------------------------------------------
# 10001xx - SCAN
# -----------------------------------------------------------------------------

alert tcp any any -> any any (msg:"SCAN Nmap Xmas Scan detected (FUP flags)"; flow:stateless; flags:FUP; classtype:attempted-recon; priority:2; sid:1000100; rev:2;)
alert tcp any any -> any any (msg:"SCAN Nmap Null Scan detected (No flags)"; flow:stateless; flags:0; classtype:attempted-recon; priority:2; sid:1000101; rev:2;)
alert tcp any any -> any any (msg:"SCAN Nmap FIN Scan detected"; flow:stateless; flags:F; classtype:attempted-recon; priority:2; sid:1000102; rev:2;)
alert tcp any any -> any any (msg:"SCAN Suspicious SYN-FIN packet detected"; flow:stateless; flags:SF+; classtype:attempted-recon; priority:1; sid:1000103; rev:2;)


# -----------------------------------------------------------------------------
# 10002xx - DOS
# -----------------------------------------------------------------------------

alert tcp any any -> any $HTTP_PORTS (msg:"DOS SYN Flood attempt to HTTP port"; flow:stateless; flags:S,CE; detection_filter:track by_dst, count 10, seconds 1; classtype:denial-of-service; priority:1; sid:1000201; rev:2;)
alert tcp any any -> any $HTTP_PORTS (msg:"DOS Slowloris HTTP header probe detected"; flow:to_server,established; http_header; content:"X-a: b",nocase; service:http; classtype:denial-of-service; priority:2; sid:1000202; rev:2;)
alert icmp any any -> any any (msg:"DOS Large ICMP echo request (Ping of Death)"; itype:8; dsize:>800; classtype:denial-of-service; priority:1; sid:1000203; rev:2;)
alert udp any any -> any 123 (msg:"DOS NTP monlist query attempt"; content:"|17 00 03 2A|",depth 4; classtype:denial-of-service; priority:2; sid:1000204; rev:2;)


# -----------------------------------------------------------------------------
# 10003xx - AUTH
# -----------------------------------------------------------------------------

alert tcp any any -> any 22 (msg:"AUTH SSH probe banner attempt"; flow:to_server,established; content:"SSH-2.0",depth 7; classtype:attempted-recon; priority:2; sid:1000301; rev:2;)
alert tcp any any -> any 21 (msg:"AUTH FTP anonymous login attempt"; flow:to_server,established; content:"USER anonymous",nocase,depth 14; classtype:attempted-recon; priority:2; sid:1000302; rev:2;)
alert tcp any any -> any $HTTP_PORTS (msg:"AUTH HTTP Basic Authorization header detected"; flow:to_server,established; http_header:field authorization; content:"Basic ",nocase,depth 6; service:http; classtype:attempted-admin; priority:2; sid:1000303; rev:2;)
alert tcp any any -> any $HTTP_PORTS (msg:"AUTH Web Admin Login Submission"; flow:to_server,established; http_method; content:"POST"; http_uri; content:"/admin/login",nocase; service:http; classtype:attempted-admin; priority:1; sid:1000304; rev:2;)


# -----------------------------------------------------------------------------
# 10004xx - MALWARE, C2
# -----------------------------------------------------------------------------

alert tcp any any -> any $HTTP_PORTS (msg:"MALWARE PHP Webshell execution (eval base64)"; flow:to_server,established; http_client_body; content:"eval(base64_decode(",nocase; service:http; classtype:web-application-attack; priority:1; sid:1000401; rev:2;)
alert tcp any any -> any any (msg:"MALWARE Linux Reverse Shell pattern detected"; flow:established; content:"/bin/bash -i"; classtype:trojan-activity; priority:1; sid:1000402; rev:2;)
alert tcp any any -> any any (msg:"MALWARE PowerShell DownloadString execution"; flow:established; content:"DownloadString",nocase; classtype:trojan-activity; priority:1; sid:1000403; rev:2;)
alert tcp any any -> any $HTTP_PORTS (msg:"C2 Automated Attack Tool User-Agent (sqlmap)"; flow:to_server,established; http_header:field user-agent; content:"sqlmap",nocase; service:http; classtype:attempted-recon; priority:2; sid:1000404; rev:2;)
alert tcp any any -> any $HTTP_PORTS (msg:"C2 Automated Attack Tool User-Agent (nikto)"; flow:to_server,established; http_header:field user-agent; content:"Nikto",nocase; service:http; classtype:attempted-recon; priority:2; sid:1000405; rev:2;)


# -----------------------------------------------------------------------------
# 10005xx - RECON (UDP / ICMP)
# -----------------------------------------------------------------------------

alert udp any any -> any 161 (msg:"RECON SNMP public community string probe"; content:"|04 06|public",depth 16; classtype:attempted-recon; priority:2; sid:1000501; rev:2;)
alert udp any any -> any 53 (msg:"RECON DNS Tunneling suspicious domain query"; content:"c2tunnel",nocase; classtype:trojan-activity; priority:1; sid:1000502; rev:2;)
alert icmp any any -> any any (msg:"RECON ICMP Timestamp request scan"; itype:13; icode:0; classtype:attempted-recon; priority:3; sid:1000503; rev:2;)
