# UDP & ICMP RECONNAISSANCE / EXPLOIT RULES
# Format: alert [proto] [src_ip] [src_port] -> [dst_ip] [dst_port] (options)

# SID:1000501 - SNMP Default 'public' community string scan
alert udp any any -> any 161 (msg:"RECON SNMP public community string probe"; content:"public"; sid:1000501; rev:1; classtype:attempted-recon; severity:2;)

# SID:1000502 - DNS Tunneling / C2 exfiltration query
alert udp any any -> any 53 (msg:"RECON DNS Tunneling suspicious domain query"; content:"c2tunnel"; nocase; sid:1000502; rev:1; classtype:trojan-activity; severity:1;)

# SID:1000503 - ICMP Timestamp sweep probe
alert icmp any any -> any any (msg:"RECON ICMP Timestamp request scan"; content:"ICMP_TIMESTAMP_PROBE"; sid:1000503; rev:1; classtype:attempted-recon; severity:3;)
