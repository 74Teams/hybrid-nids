# Sao chép thành lab/vmware/.env (file này bị git ignore). VM IDS và VM Victim phải dùng CÙNG giá trị.
# Mật khẩu nên là chuỗi hex, không chứa $, dấu nháy hay backtick.

# Mật khẩu root của MySQL (bắt buộc, chỉ dùng trên VM IDS): openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
# Mật khẩu tài khoản ứng dụng NIDS trong MySQL (bắt buộc)
NIDS_DB_PASSWORD=
# Mật khẩu Redis (bắt buộc)
NIDS_REDIS_PASSWORD=
# API key của NIDS (tuỳ chọn, chỉ dùng trên VM IDS): openssl rand -hex 32
NIDS_API_KEY=
